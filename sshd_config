# =========================================================
#  SSHD CONFIG — HARDENED FOR BLUE TEAM / PRODUCTION
#  Threat model: brute-force, credential stuffing, abuse
# =========================================================

# --- Network ---
Port 2222
AddressFamily inet
ListenAddress 0.0.0.0

# --- Protocol ---
Protocol 2

# --- Host Keys ---
HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_rsa_key

# --- Authentication ---
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
UsePAM yes

PubkeyAuthentication yes
AuthenticationMethods publickey

MaxAuthTries 3
MaxSessions 2
LoginGraceTime 20

# --- User Restrictions ---
AllowUsers window
DenyUsers root
AllowGroups sudo

# --- Disable Dangerous Features ---
PermitEmptyPasswords no
PermitUserEnvironment no
PermitTunnel no
AllowTcpForwarding no
AllowStreamLocalForwarding no
GatewayPorts no
X11Forwarding no
PermitTTY yes

# --- Connection Hardening ---
ClientAliveInterval 300
ClientAliveCountMax 2
TCPKeepAlive no

# --- Crypto Hardening ---
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org

# --- Logging & Auditing ---
SyslogFacility AUTH
LogLevel VERBOSE

# --- Banner (optional but recommended) ---
Banner /etc/issue.net

# --- DNS / Enumeration Protection ---
UseDNS no
PrintMotd no
PrintLastLog yes

# --- Environment ---
AcceptEnv LANG LC_*

# --- Subsystems ---
Subsystem sftp internal-sftp

# --- Rate Limiting (handled by Fail2Ban / firewall) ---
# sshd intentionally kept strict; IP bans handled externally

# =========================================================
#  END OF FILE
# =========================================================
